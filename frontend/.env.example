# Predictive Kubernetes Autoscaling Dashboard Environment
# When running with Vite dev server, empty string uses the Vite proxy to http://localhost:8080
VITE_API_BASE_URL=
# Or specify full URL:
# VITE_API_BASE_URL=http://localhost:8080

# Auto-polling interval in milliseconds (default: 5000ms)
VITE_POLL_INTERVAL_MS=5000
